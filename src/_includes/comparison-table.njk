<div class="comparison-table-wrap fade-up">
  <table class="comparison-table">
    <thead>
      <tr>
        <th scope="col" class="comparison-feature-col"></th>
        <th scope="col">Fixed Full-Arch Implants</th>
        <th scope="col">Snap-In Implant Denture</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Removable?</th>
        <td>No — stays in permanently</td>
        <td>Yes — removed daily for cleaning</td>
      </tr>
      <tr>
        <th scope="row">How it attaches</th>
        <td>Screwed to implants; only removed by a clinician</td>
        <td>Clips or snaps onto implants</td>
      </tr>
      <tr>
        <th scope="row">Cleaning</th>
        <td>Brush and floss like natural teeth</td>
        <td>Remove and clean separately each day</td>
      </tr>
      <tr>
        <th scope="row">Stability</th>
        <td>Fixed in place — does not move</td>
        <td>Dramatically reduced movement vs. conventional dentures</td>
      </tr>
      {% if siteContent.pricing and siteContent.pricing.showCostTier %}
      <tr>
        <th scope="row">Relative cost</th>
        <td>$$$</td>
        <td>$$</td>
      </tr>
      {% endif %}
    </tbody>
  </table>
</div>
